[Unit]
Description=Mouxtaris EOA Pafos water-outage scraper
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/opt/mouxtaris/eoa-pafos-service
ExecStart=/home/opc/opt/mouxtaris/eoa-pafos-service/.venv/bin/python3 eoa_pafos_scrape.py
EnvironmentFile=/etc/mouxtaris/scraper.env
Restart=on-failure
RestartSec=10s

# The script's own loop already paces itself (--interval, default 900s);
# Restart=on-failure is just a backstop for a crash, not the polling cadence.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mouxtaris-eoa-pafos

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
